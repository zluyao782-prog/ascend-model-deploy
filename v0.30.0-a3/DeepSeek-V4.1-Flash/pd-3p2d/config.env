# =============================================================================
# DeepSeek-V4.1-Flash PD 分离 3P2D（5 台 × 16 卡，A3 rank 组网）—— 五台共用这一份
#
# 用法，顺序不能颠倒：
#   每台 Decode（2 台）: bash start.sh decode
#   每台 Prefill（3 台）: bash start.sh prefill
#   代理那台:            bash start.sh proxy
#
# 拓扑：P 三台 × (4 引擎 × TP4) = 48 卡，全局 DP12，rank 0-11
#       D 两台 × (16 引擎 × TP1)  = 32 卡，全局 DP32，rank 0-31
#
# 和 2P2D 的差别只在 P 组多一台（DP8 → DP12），单台配比没变，
# 所以 run_p.sh / run_d.sh 里除了多一组 rank 组网变量，其余照旧。
# =============================================================================

# ---------------------------------------------------------------- 必改 4 项
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"   # 五台必须同一绝对路径
SERVED_MODEL_NAME="dsv41"                                   # 对外模型名
# 本项目基线 = openEuler 构建（tag 带 -openeuler）。它和 quay.io 官方构建不是一份东西：
# examples 在 external_online_dp、没有 --pcp-size。换 tag 时先核对 ../../README.md 的对照表。
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3-openeuler"   # 内网必须先 docker load，脚本不会 pull
NIC_NAME="eth0"                                             # 通信网卡：业务口，不是管理口

# ---------------------------------------------------------------- 镜像内路径
# launcher / 代理脚本随镜像分发，不落仓库。openEuler 构建在 external_online_dp，
# 官方构建在 disaggregated_prefill_v1 —— 报「镜像里找不到」时用 find 查，填这里即可：
#   docker run --rm $IMAGE find / -name launch_online_dp.py
IMAGE_DIR="/vllm-workspace/vllm-ascend/examples/external_online_dp"

# ---------------------------------------------------------------- 节点（顺序就是 rank 顺序）
PREFILL_NODES="192.168.0.11 192.168.0.12 192.168.0.13"
DECODE_NODES="192.168.0.21 192.168.0.22"
PROXY_NODE="192.168.0.11"      # 代理跑 P1；留空也是这个效果

# ---------------------------------------------------------------- 拓扑：每台起几个引擎
# 单台卡数 = *_TP × *_DP_LOCAL（这个构建 PCP 恒为 1，见下面那行）
PREFILL_DP_LOCAL=4             # P：4 引擎 × TP4 = 16 卡/台，三台合计 DP12
DECODE_DP_LOCAL=16             # D：16 引擎 × TP1 = 16 卡/台，两台合计 DP32
PREFILL_TP=4                   # P 侧靠 TP 占满 16 卡：这个镜像没有 --pcp-size
DECODE_TP=1
PREFILL_PCP=1                  # openEuler 构建不支持 PCP。换官方构建才改回 TP1 + PCP4

# ---------------------------------------------------------------- 端口
# 五台之间要放开：7100-7115、12321、1999、30000-30011、30100-30131、HCCL 段
PREFILL_BASE_PORT=7100
DECODE_BASE_PORT=7100
DP_RPC_PORT=12321
KV_PRODUCER_PORT=30000         # 30000 + 全局 rank（P 是 0-11）
KV_CONSUMER_PORT=30100         # 30100 + 全局 rank（D 是 0-31）
PROXY_PORT=1999

# ---------------------------------------------------------------- rank 组网（A3 走 RoCE）
# 这组变量五台必须完全一致，而且只在进程启动时读一次：
# 改完要 stop.sh + start.sh 全部重来，单台改一半是最难查的故障。
HCCL_INTER_HCCS_DISABLE="TRUE"   # 跨机不走 HCCS，改走 RoCE
HCCL_INTRA_ROCE_ENABLE=1         # 机内也走 RoCE，不用机内 HCCS
HCCL_IF_BASE_PORT=52000          # HCCL 通信端口基址，五台一致
# 端口段从 52000 起，宽度按引擎数算，防火墙建议整段放开 52000-52999

# ---------------------------------------------------------------- Mooncake
KV_CONNECTOR="MooncakeHybridConnector"
KV_POOL="on"                   # on: KV 走 Mooncake 共享池；off: 退化为点对点传输
MOONCAKE_MASTER=""             # mooncake_master 地址，留空取 P 组第一台 + :50099
MOONCAKE_MASTER_PORT=50099

# 池化内存：这两个值是「每个引擎」的，不是整台的总量。
#   P 台 4 引擎  → 4 × SEGMENT + 4 × BUFFER
#   D 台 16 引擎 → 16 × SEGMENT + 16 × BUFFER
# 现在 2GB/1GB 的配法：P 台约 12G，D 台约 48G。嫌多就只降 SEGMENT。
MOONCAKE_SEGMENT="2GB"
MOONCAKE_BUFFER="1GB"

# ---------------------------------------------------------------- 模型
MAX_MODEL_LEN=1048576          # 单引擎单卡，和 2P2D 的 D 节点是同一份预算；
                               # 起不来（OOM）先降到 524288 再试

# ---------------------------------------------------------------- 容器
CONTAINER_NAME="dsv41-3p2d"    # 实际名带角色后缀：dsv41-3p2d-prefill / -decode / -proxy
SHM_SIZE="64g"                 # Engram 表要在本地 DP rank 间共享主机内存

# ---------------------------------------------------------------- 下面自动算，不用改
P_DP_SIZE=$(( PREFILL_DP_LOCAL * $(echo $PREFILL_NODES | wc -w) ))
D_DP_SIZE=$(( DECODE_DP_LOCAL * $(echo $DECODE_NODES | wc -w) ))
# master 没填就取 P 组第一台，并补上端口
if [ -z "$MOONCAKE_MASTER" ]; then
    MOONCAKE_MASTER="$(echo $PREFILL_NODES | awk '{print $1}'):$MOONCAKE_MASTER_PORT"
fi
case "$MOONCAKE_MASTER" in
    *:* ) ;;
    *   ) MOONCAKE_MASTER="$MOONCAKE_MASTER:$MOONCAKE_MASTER_PORT" ;;
esac

# ---------------------------------------------------------------- 只有体检脚本用，不用改
MODEL_NAME="DeepSeek-V4.1-Flash"
DEPLOY_MODE="pd"
NPU_COUNT=16
HOST_MEM_MIN_GB=384
DISK_MIN_GB=800
CROSS_NODE=1
