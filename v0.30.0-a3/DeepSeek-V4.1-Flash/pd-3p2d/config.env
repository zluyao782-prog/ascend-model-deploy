# =============================================================================
# DeepSeek-V4.1-Flash 3P2D（3 台 Prefill + 2 台 Decode，各 16 卡）
#
# 五台共用这一份，内容完全一样。每台只跑一条命令：
#   Decode 那两台 :  bash start.sh decode
#   Prefill 那三台:  bash start.sh prefill
#   代理那台      :  bash start.sh proxy     （等后端全绿再起）
#
# 拓扑：P 3 台 ×（4 引擎 × TP4）= 48 卡，全局 DP 12
#       D 2 台 ×（16 引擎 × TP1）= 32 卡，全局 DP 32
# =============================================================================

# ---------------------------------------------------------------- 必改
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"   # 五台必须同一绝对路径
SERVED_MODEL_NAME="dsv41"                                   # 对外模型名
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3-openeuler"      # 内网必须先 docker load
NIC_NAME="eth0"                                             # 业务网卡，不是管理口

# 官方 launcher / 代理脚本在镜像里的位置（openEuler 构建；换镜像用 find 查了再填）
IMAGE_DIR="/vllm-workspace/vllm-ascend/examples/external_online_dp"

# ---------------------------------------------------------------- 节点
# 顺序就是 rank 顺序，第一台兼 DP 协调。代理跑在哪台都行，五台都能执行 proxy。
PREFILL_NODES="192.168.0.11 192.168.0.12 192.168.0.13"
DECODE_NODES="192.168.0.21 192.168.0.22"

# ---------------------------------------------------------------- 拓扑
# 单台卡数 = *_TP × *_DP_LOCAL，必须等于 16
PREFILL_DP_LOCAL=4              # P：4 引擎 × TP4 = 16 卡
DECODE_DP_LOCAL=16              # D：16 引擎 × TP1 = 16 卡
PREFILL_TP=4                    # 这个镜像没有 PCP，P 侧靠 TP 占满 16 卡
DECODE_TP=1

# ---------------------------------------------------------------- 端口
PREFILL_BASE_PORT=7100
DECODE_BASE_PORT=7100
DP_RPC_PORT=12321
KV_PRODUCER_PORT=30000          # 30000 + 全局 rank（P 是 0-11）
KV_CONSUMER_PORT=30100          # 30100 + 全局 rank（D 是 0-31）
PROXY_PORT=1999

# ---------------------------------------------------------------- A3 rank 组网
# 五台必须完全一致，只在进程启动时读一次，改了要全部重启。
HCCL_INTER_HCCS_DISABLE="TRUE"  # 跨机不走 HCCS，走 RoCE
HCCL_INTRA_ROCE_ENABLE=1        # 机内也走 RoCE
HCCL_IF_BASE_PORT=52000         # HCCL 端口基址，防火墙整段放开 52000-52999

# ---------------------------------------------------------------- Mooncake（P→D 的 KV 传输）
# 连接器是 MooncakeHybridConnector，走的是点对点传输，不是外部 KV 池。
# 每个引擎按 global_segment_size 向传输引擎注册内存，是「每引擎」的量：
#   P 台 4 引擎  → 4 × (2GB + 1GB) = 12 GB
#   D 台 16 引擎 → 16 × (2GB + 1GB) = 48 GB
KV_CONNECTOR="MooncakeHybridConnector"
MOONCAKE_MASTER=""              # 留空 = P 组第一台:50099
MOONCAKE_MASTER_PORT=50099
MOONCAKE_SEGMENT="2GB"
MOONCAKE_BUFFER="1GB"

# 外部 KV 池（AscendStoreConnector）
#   on ：传输 + 池化两个连接器一起用，套在 MultiConnector 下；KV 会写进共享池
#   off：只做 P→D 传输，KV 不跨请求复用
# 注意 mooncake.json 只决定"怎么连上 Mooncake"，走哪条路由这里决定。
KV_STORE="on"
KV_STORE_BACKEND="mooncake"     # mooncake / memcache
KV_STORE_D_READ="on"            # D 侧是否从池里读；off 就是只有 P 写、D 不读

# ---------------------------------------------------------------- 模型
MAX_MODEL_LEN=1048576           # 起不来（OOM）先降到 524288

# ---------------------------------------------------------------- 容器
CONTAINER_NAME="dsv41-3p2d"     # 实际名带角色后缀：-prefill / -decode / -proxy
SHM_SIZE="64g"                  # Engram 表要在本地 DP rank 间共享主机内存

# ---------------------------------------------------------------- 下面自动算，不用改
P_DP_SIZE=$(( PREFILL_DP_LOCAL * $(echo $PREFILL_NODES | wc -w) ))
D_DP_SIZE=$(( DECODE_DP_LOCAL * $(echo $DECODE_NODES | wc -w) ))
if [ -z "$MOONCAKE_MASTER" ]; then
    MOONCAKE_MASTER="$(echo $PREFILL_NODES | awk '{print $1}'):$MOONCAKE_MASTER_PORT"
fi
case "$MOONCAKE_MASTER" in
    *:* ) ;;
    *   ) MOONCAKE_MASTER="$MOONCAKE_MASTER:$MOONCAKE_MASTER_PORT" ;;
esac

# ---------------------------------------------------------------- 只有 _shared/preflight.sh 用
MODEL_NAME="DeepSeek-V4.1-Flash"
DEPLOY_MODE="pd"
NPU_COUNT=16
HOST_MEM_MIN_GB=384
DISK_MIN_GB=800
CROSS_NODE=1
