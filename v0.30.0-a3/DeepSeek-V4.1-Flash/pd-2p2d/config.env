# =============================================================================
# DeepSeek-V4.1-Flash @ Atlas 800 A3 ×4 —— PD 分离 2P2D
#
# 部署形态：pd
# 组网：Prefill DP8（本地 4/台 ×2）+ Decode DP32（本地 16/台 ×2）= 64 卡
#
# 脚本从 ../../../../_shared 读取，本文件只描述「这 4 台怎么组」
# =============================================================================

# ---------------------------------------------------------------- 模型
MODEL_NAME="DeepSeek-V4.1-Flash"
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"   # 4 台必须同一绝对路径
SERVED_MODEL_NAME="dsv41"

# ---------------------------------------------------------------- 镜像与容器
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3"
CONTAINER_NAME="dsv41-a3-pd"
WORKDIR_CTR="/opt/ascend-model-deploy"
SHM_SIZE="64g"                 # Engram 表在本地 DP rank 间共享主机内存
EXTRA_MOUNTS=""

# ---------------------------------------------------------------- 硬件与网络
NIC_NAME="eth0"                # RoCE 业务口，不是管理口
NPU_COUNT=16
HOST_MEM_MIN_GB=512            # Engram offload + 32 个 Decode 引擎
DISK_MIN_GB=800
CROSS_NODE=1

# ---------------------------------------------------------------- 模式
DEPLOY_MODE="pd"

# ---------------------------------------------------------------- 节点（顺序 = DP rank 顺序）
PREFILL_NODES="192.168.0.11 192.168.0.12"
DECODE_NODES="192.168.0.21 192.168.0.22"
PROXY_NODE="192.168.0.11"      # 代理复用 P1

# ---------------------------------------------------------------- 拓扑：2P2D
PREFILL_DP_LOCAL=4             # 4 引擎 × PCP4 = 16 卡
DECODE_DP_LOCAL=16             # 16 引擎 × TP1 = 16 卡
PREFILL_TP=1
DECODE_TP=1
PREFILL_PCP=4

PREFILL_BASE_PORT=7100         # P1/P2 各 7100-7103
DECODE_BASE_PORT=7100          # D1/D2 各 7100-7115
DP_RPC_PORT=12321
KV_PRODUCER_PORT=30000         # 30000 + rank → 30000-30007
KV_CONSUMER_PORT=30100         # 30100 + rank → 30100-30131
PROXY_PORT=1999
KV_CONNECTOR="MooncakeHybridConnector"

# ---------------------------------------------------------------- 推理参数
MAX_MODEL_LEN=1048576          # 该模型支持 1M 上下文
MAX_NUM_BATCHED_TOKENS_P=8192  # P 偏 prompt 吞吐
MAX_NUM_BATCHED_TOKENS_D=512   # D 偏解码并发
MAX_NUM_SEQS_P=16
MAX_NUM_SEQS_D=72
GPU_MEM_UTIL=0.95
QUANTIZATION="ascend"
BLOCK_SIZE=128

# ---------------------------------------------------------------- 环境微调
HCCL_BUFFSIZE_P=1024
HCCL_BUFFSIZE_D=4096
HCCL_EXEC_TIMEOUT=""
VLLM_ENGINE_READY_TIMEOUT_S=36000   # 32 引擎加载慢，官方值，别调小
