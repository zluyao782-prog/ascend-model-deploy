# =============================================================================
# DeepSeek-V4.1-Flash PD 分离 2P2D（4 台 × 16 卡）—— 4 台共用这一份
#
# 用法（每台按自己的角色执行，顺序不能颠倒：先全部 decode，再全部 prefill，最后 proxy）：
#   Decode 节点:  bash start.sh decode
#   Prefill 节点: bash start.sh prefill
#   代理节点:     bash start.sh proxy
# =============================================================================

# ---------------------------------------------------------------- 必改 4 项
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"   # 4 台必须同一绝对路径
SERVED_MODEL_NAME="dsv41"                                   # 对外模型名
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3"               # 内网必须先 docker load
NIC_NAME="eth0"                                             # 通信网卡：业务口，不是管理口

# ---------------------------------------------------------------- 节点（顺序就是 rank 顺序）
PREFILL_NODES="192.168.0.11 192.168.0.12"
DECODE_NODES="192.168.0.21 192.168.0.22"
PROXY_NODE="192.168.0.11"      # 代理跑在哪台；留空则用 P 组第一台

# ---------------------------------------------------------------- 拓扑：每台起几个引擎
# 单台卡数 = *_TP × *_PCP × *_DP_LOCAL，16 卡就填满 16
PREFILL_DP_LOCAL=4             # P：4 引擎 × PCP4 = 16 卡
DECODE_DP_LOCAL=16             # D：16 引擎 × TP1 = 16 卡
PREFILL_TP=1
DECODE_TP=1
PREFILL_PCP=4                  # 上下文并行，只有 Prefill 有；Decode 恒为 1

# ---------------------------------------------------------------- 端口
# 跨节点防火墙要放开：7100-7115、12321、30000-30031、1999（TCP）
PREFILL_BASE_PORT=7100
DECODE_BASE_PORT=7100
DP_RPC_PORT=12321
KV_PRODUCER_PORT=30000         # KV 生产端 = 30000 + 全局 rank
KV_CONSUMER_PORT=30100         # KV 消费端 = 30100 + 全局 rank
PROXY_PORT=1999
KV_CONNECTOR="MooncakeHybridConnector"

# ---------------------------------------------------------------- 模型
MAX_MODEL_LEN=1048576          # 该模型支持 1M；显存不够就往下调

# ---------------------------------------------------------------- 容器
CONTAINER_NAME="dsv41-2p2d"    # 实际名带角色后缀：dsv41-2p2d-prefill / -decode / -proxy
SHM_SIZE="64g"                 # Engram 表要在本地 DP rank 间共享主机内存

# ---------------------------------------------------------------- 下面自动算，不用改
P_DP_SIZE=$(( PREFILL_DP_LOCAL * $(echo $PREFILL_NODES | wc -w) ))
D_DP_SIZE=$(( DECODE_DP_LOCAL * $(echo $DECODE_NODES | wc -w) ))

# ---------------------------------------------------------------- 只有体检脚本用，不用改
MODEL_NAME="DeepSeek-V4.1-Flash"
DEPLOY_MODE="pd"
NPU_COUNT=16
HOST_MEM_MIN_GB=512
DISK_MIN_GB=800
CROSS_NODE=1
