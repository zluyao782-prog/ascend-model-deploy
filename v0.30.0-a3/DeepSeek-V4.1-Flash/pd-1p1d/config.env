# =============================================================================
# DeepSeek-V4.1-Flash PD 分离 1P1D（2 台 × 16 卡）—— 两台共用这一份
#
# 用法，顺序不能颠倒：
#   Decode 那台:   bash start.sh decode
#   Prefill 那台:  bash start.sh prefill
#   还在 Prefill 那台: bash start.sh proxy     （每台可起多个容器，按角色分开命名）
#
# 每台的引擎配比和 pd-2p2d 完全一样，只是各少了另一半节点：
#   P 一台跑 4 引擎 × PCP4 = 16 卡；D 一台跑 16 引擎 × TP1 = 16 卡。
# 所以从 2P2D 缩到 1P1D 时，run_p.sh / run_d.sh 一个字都不用改。
# =============================================================================

# ---------------------------------------------------------------- 必改 4 项
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"   # 两台必须同一绝对路径
SERVED_MODEL_NAME="dsv41"                                   # 对外模型名
# openEuler 构建的 tag 带 -openeuler，examples 路径也不同，见 ../../README.md
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3"               # 内网必须先 docker load
NIC_NAME="eth0"                                             # 通信网卡：业务口，不是管理口

# ---------------------------------------------------------------- 可选：镜像内路径
# 官方 launcher / 代理脚本在镜像里的位置。留空用默认路径（vllm-ascend 0.30 的）。
# 报「镜像里找不到 xxx」时，用 find 查出来填这里，不用改脚本：
#   docker run --rm $IMAGE find / -name launch_online_dp.py
# 官方构建在 examples/disaggregated_prefill_v1/，openEuler 构建在 examples/external_online_dp/
IMAGE_DIR=""

# ---------------------------------------------------------------- 节点
PREFILL_NODES="192.168.0.11"
DECODE_NODES="192.168.0.21"
PROXY_NODE="192.168.0.11"      # 代理跑 Prefill 那台；留空也是这个效果

# ---------------------------------------------------------------- 拓扑：每台起几个引擎
# 单台卡数 = *_TP × *_PCP × *_DP_LOCAL，16 卡就填满 16
PREFILL_DP_LOCAL=4             # P：4 引擎 × PCP4 = 16 卡
DECODE_DP_LOCAL=16             # D：16 引擎 × TP1 = 16 卡
PREFILL_TP=1
DECODE_TP=1
PREFILL_PCP=4                  # 上下文并行，只有 Prefill 有；Decode 恒为 1

# ---------------------------------------------------------------- 端口
# 两台之间要放开：7100-7115、12321、30000-30003、30100-30115（TCP）
PREFILL_BASE_PORT=7100
DECODE_BASE_PORT=7100
DP_RPC_PORT=12321
KV_PRODUCER_PORT=30000         # KV 生产端 = 30000 + 全局 rank（P 只有 0-3）
KV_CONSUMER_PORT=30100         # KV 消费端 = 30100 + 全局 rank（D 是 0-15）
PROXY_PORT=1999
KV_CONNECTOR="MooncakeHybridConnector"

# ---------------------------------------------------------------- 模型
MAX_MODEL_LEN=1048576          # 单引擎单卡，和 2P2D 的 D 节点是同一份预算；
                               # 真起不来（OOM）先降到 524288 再试

# ---------------------------------------------------------------- 容器
CONTAINER_NAME="dsv41-1p1d"    # 实际名带角色后缀：dsv41-1p1d-prefill / -decode / -proxy
SHM_SIZE="64g"                 # Engram 表要在本地 DP rank 间共享主机内存

# ---------------------------------------------------------------- 下面自动算，不用改
P_DP_SIZE=$(( PREFILL_DP_LOCAL * $(echo $PREFILL_NODES | wc -w) ))
D_DP_SIZE=$(( DECODE_DP_LOCAL * $(echo $DECODE_NODES | wc -w) ))

# ---------------------------------------------------------------- 只有体检脚本用，不用改
MODEL_NAME="DeepSeek-V4.1-Flash"
DEPLOY_MODE="pd"
NPU_COUNT=16
HOST_MEM_MIN_GB=384            # D 那台 16 个引擎 + Engram offload，P 那台压力小些
DISK_MIN_GB=800
CROSS_NODE=1
