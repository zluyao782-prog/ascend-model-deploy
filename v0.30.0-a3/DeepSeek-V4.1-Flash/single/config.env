# =============================================================================
# DeepSeek-V4.1-Flash @ Atlas 800 A3 单机（1 台 16 卡，DP4 × TP4）
#
# 部署形态：single
# 用途：POC / 小并发基线 / 不需要多机网络的最小验证
#
# 脚本从 ../../../../_shared 读取，本文件只描述「这一台怎么起」
# 公共项的含义见 ../../../README.md
# =============================================================================

# ---------------------------------------------------------------- 模型
MODEL_NAME="DeepSeek-V4.1-Flash"
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"
SERVED_MODEL_NAME="dsv41"

# ---------------------------------------------------------------- 镜像与容器
# 与所在版本目录一致；换硬件系列时改这里，并新建对应版本目录
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3"
CONTAINER_NAME="dsv41-a3-single"
WORKDIR_CTR="/opt/ascend-model-deploy"
SHM_SIZE="64g"
EXTRA_MOUNTS=""

# ---------------------------------------------------------------- 硬件与网络
NIC_NAME="eth0"
NPU_COUNT=16
HOST_MEM_MIN_GB=384
DISK_MIN_GB=800
CROSS_NODE=0                   # 单机，跳过跨节点检查

# ---------------------------------------------------------------- 模式
DEPLOY_MODE="single"

# ---------------------------------------------------------------- 单机拓扑
# 16 卡 = TP4 × DP4；单卡放不下 552B 权重，必须 TP>1
SINGLE_TP=4
SINGLE_DP=4
SINGLE_PORT=8000

# 本模型单机场景的追加参数（dspark 投机解码 + Engram offload）
SINGLE_EXTRA_ARGS="--enable-expert-parallel \
--speculative-config '{\"num_speculative_tokens\":5,\"method\":\"dspark\"}' \
--tokenizer-mode deepseek_v41 \
--reasoning-parser deepseek_v41 \
--tool-call-parser deepseek_v41 \
--enable-auto-tool-choice \
--safetensors-load-strategy lazy \
--engram-config '{\"cpu_offload\":true,\"dp_shared_memory\":true}'"

# ---------------------------------------------------------------- 推理参数
MAX_MODEL_LEN=131072           # 单机显存有限，先按 128K 起；A3 支持更长但需实测
MAX_NUM_BATCHED_TOKENS_D=512
MAX_NUM_SEQS_D=32
GPU_MEM_UTIL=0.9
QUANTIZATION="ascend"
BLOCK_SIZE=128

# ---------------------------------------------------------------- 环境微调
HCCL_EXEC_TIMEOUT=""
VLLM_ENGINE_READY_TIMEOUT_S=36000
