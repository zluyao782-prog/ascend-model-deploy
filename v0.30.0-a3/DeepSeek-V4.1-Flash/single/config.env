# =============================================================================
# DeepSeek-V4.1-Flash 单机（1 台 × 16 卡）—— 现场只改这个文件
#
# 用法：
#   bash start.sh     启动
#   bash check.sh     验证
#   bash stop.sh      停止
# =============================================================================

# ---------------------------------------------------------------- 必改 4 项
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"   # 宿主机与容器内必须同一路径
SERVED_MODEL_NAME="dsv41"                                   # 对外模型名，客户端填这个
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3"               # 内网必须先 docker load，不会自动 pull
NIC_NAME="eth0"                                             # 通信网卡：业务口，不是管理口

# ---------------------------------------------------------------- 拓扑
# TP × DP 必须等于本机卡数。552B 权重单卡放不下，TP 不能取 1。
SINGLE_TP=4
SINGLE_DP=4
SINGLE_PORT=8000

# ---------------------------------------------------------------- 模型参数
MAX_MODEL_LEN=131072     # 单机显存比 PD 紧张，先按 128K 起；OOM 就先调小这个
GPU_MEM_UTIL=0.9         # 0.9 起步；推到 0.95 会提高并发，但容易出现不定期 OOM
MAX_NUM_BATCHED_TOKENS=512
MAX_NUM_SEQS=32

# ---------------------------------------------------------------- 容器
CONTAINER_NAME="dsv41-single"
SHM_SIZE="64g"           # Engram 表要在本地 DP rank 间共享主机内存

# ---------------------------------------------------------------- 以下只有体检脚本用，一般不用改
MODEL_NAME="DeepSeek-V4.1-Flash"
DEPLOY_MODE="single"
NPU_COUNT=16
HOST_MEM_MIN_GB=384
DISK_MIN_GB=800
CROSS_NODE=0
