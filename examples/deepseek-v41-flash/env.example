# =============================================================================
# DeepSeek-V4.1-Flash · Atlas 800 A3 ×4（2P2D）实测配置
#
# 用法：
#   cp examples/deepseek-v41-flash/env.example config/env
#   vim config/env         # 只改 4 台 IP、NIC_NAME、MODEL_PATH
#
# 与 config/env.example 的差异已在下文标出，其余项沿用公共模板语义
# =============================================================================

# ---------------------------------------------------------------- 模型
MODEL_NAME="deepseek-v41-flash"
MODEL_PATH="/data/weights/DeepSeek-V4.1-Flash-1017-w4a8"   # 4 台必须同一绝对路径
SERVED_MODEL_NAME="dsv41"

# ---------------------------------------------------------------- 镜像与容器
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a3"              # A3 专用 tag，勿用 a2
CONTAINER_NAME="deepseek-v41"
WORKDIR_CTR="/opt/ascend-model-deploy"
SHM_SIZE="64g"
EXTRA_MOUNTS=""

# ---------------------------------------------------------------- 硬件与网络
NIC_NAME="eth0"                 # 现场确认是 RoCE 业务口，不是管理口
NPU_COUNT=16                    # A3 单机 16 逻辑设备
HOST_MEM_MIN_GB=512             # Engram offload + 32 引擎，内存必须够
DISK_MIN_GB=800
CROSS_NODE=1

# ---------------------------------------------------------------- 模式
DEPLOY_MODE="pd"

# ---------------------------------------------------------------- PD 拓扑：2P2D
PREFILL_NODES="192.168.0.11 192.168.0.12"
DECODE_NODES="192.168.0.21 192.168.0.22"
PROXY_NODE="192.168.0.11"       # 复用 P1

PREFILL_DP_LOCAL=4              # 4 引擎 × PCP4 = 16 卡
DECODE_DP_LOCAL=16              # 16 引擎 × TP1 = 16 卡
PREFILL_TP=1
DECODE_TP=1
PREFILL_PCP=4

PREFILL_BASE_PORT=7100          # P1/P2 各 7100-7103
DECODE_BASE_PORT=7100           # D1/D2 各 7100-7115
DP_RPC_PORT=12321
KV_PRODUCER_PORT=30000          # 30000-30007
KV_CONSUMER_PORT=30100          # 30100-30131
PROXY_PORT=1999
KV_CONNECTOR="MooncakeHybridConnector"

# ---------------------------------------------------------------- 推理参数
MAX_MODEL_LEN=1048576           # 该模型支持 1M 上下文
MAX_NUM_BATCHED_TOKENS_P=8192
MAX_NUM_BATCHED_TOKENS_D=512
MAX_NUM_SEQS_P=16
MAX_NUM_SEQS_D=72
GPU_MEM_UTIL=0.95
QUANTIZATION="ascend"           # w4a8 权重
BLOCK_SIZE=128

# 本模型私有参数：dspark 投机解码 + Engram offload
# 注意：这部分 P/D 不完全相同，仅公共项放这里；角色差异在模板中体现
EXTRA_VLLM_ARGS="--enable-expert-parallel --seed 1024 \
--speculative-config '{\"num_speculative_tokens\":5,\"method\":\"dspark\"}' \
--tokenizer-mode deepseek_v41 \
--reasoning-parser deepseek_v41 \
--tool-call-parser deepseek_v41 \
--enable-auto-tool-choice \
--safetensors-load-strategy lazy \
--engram-config '{\"cpu_offload\":true,\"dp_shared_memory\":true}'"

# ---------------------------------------------------------------- 环境微调
HCCL_BUFFSIZE_P=1024
HCCL_BUFFSIZE_D=4096
HCCL_EXEC_TIMEOUT=""
VLLM_ENGINE_READY_TIMEOUT_S=36000   # 官方值，32 引擎加载慢，别调小
