# =============================================================================
# 昇腾模型部署 —— 通用配置模板
#
# 用法：
#   cp config/env.example config/env
#   vim config/env          # 至少改 MODEL_PATH / IMAGE / NIC_NAME
#
# 约定：
#   - config/env 已被 .gitignore 忽略，不要提交现场 IP、路径、密钥
#   - 单机与 PD 两种模式共用本文件，靠 DEPLOY_MODE 切换
# =============================================================================

# ---------------------------------------------------------------- 模型
MODEL_NAME=""                                  # 模型标识（仅用于日志/文档，如 deepseek-v41-flash）
MODEL_PATH="/data/weights/my-model"            # 权重绝对路径；宿主机与容器内必须一致
SERVED_MODEL_NAME=""                           # 对外模型名，留空则取 MODEL_PATH 的 basename

# ---------------------------------------------------------------- 镜像与容器
IMAGE="quay.io/ascend/vllm-ascend:v0.30.0-a2"  # 必须选与硬件系列匹配的 tag（a2/a3）
CONTAINER_NAME="ascend-deploy"
WORKDIR_CTR="/opt/ascend-model-deploy"         # 容器内挂载点
SHM_SIZE="64g"                                 # --shm-size；多卡共享内存不够会静默失败
EXTRA_MOUNTS=""                                # 额外挂载，空格分隔，如 "/data:/data /mnt/nfs:/mnt/nfs"

# ---------------------------------------------------------------- 硬件与网络
NIC_NAME="eth0"                                # HCCL/Gloo 通信网卡名，务必用 RDMA/RoCE 业务口
NPU_COUNT="auto"                               # auto = 自动探测；也可写死如 16
HOST_MEM_MIN_GB=256                            # 预检要求的最小主机内存
DISK_MIN_GB=200                                # 权重所在盘的最小可用空间
CROSS_NODE=1                                   # 是否做跨节点连通性检查（单机填 0）

# ---------------------------------------------------------------- 运行模式
#   single = 单机多卡（vllm serve 直起）
#   pd     = Prefill / Decode 分离多机
DEPLOY_MODE="single"

# ---------------------------------------------------------------- 单机模式
SINGLE_TP=8                                    # 张量并行卡数，应等于本机 NPU 数或其整除因子
SINGLE_DP=1
SINGLE_PORT=8000
SINGLE_EXTRA_ARGS=""                           # 追加到 vllm serve 的自定义参数

# ---------------------------------------------------------------- PD 分离模式
# 节点列表用空格分隔；顺序即 DP rank 顺序，第一台为该角色的 DP 协调节点
PREFILL_NODES=""                               # 例："10.0.0.11 10.0.0.12"
DECODE_NODES=""                                # 例："10.0.0.21 10.0.0.22"
PROXY_NODE=""                                  # 代理部署在哪台，留空则取 PREFILL 第一台

PREFILL_DP_LOCAL=4                             # 单台 Prefill 上的 DP 引擎数
DECODE_DP_LOCAL=16                             # 单台 Decode 上的 DP 引擎数
PREFILL_TP=1                                   # 单 rank 的 TP，通常 1（卡数靠 DP 堆）
DECODE_TP=1
PREFILL_PCP=4                                  # Prefill 上下文并行，Decode 侧固定为 1

PREFILL_BASE_PORT=7100                         # 引擎端口起点，第 n 个 rank = BASE + n
DECODE_BASE_PORT=7100
DP_RPC_PORT=12321                              # DP 协调 RPC 端口
KV_PRODUCER_PORT=30000                         # KV producer 起始端口（按 rank 递增）
KV_CONSUMER_PORT=30100                         # KV consumer 起始端口
PROXY_PORT=1999                                # PD 代理对外端口
KV_CONNECTOR="MooncakeHybridConnector"

# ---------------------------------------------------------------- 公共推理参数
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS_P=8192                  # Prefill 偏 prompt 吞吐
MAX_NUM_BATCHED_TOKENS_D=512                   # Decode 偏解码并发
MAX_NUM_SEQS_P=16
MAX_NUM_SEQS_D=72
GPU_MEM_UTIL=0.9
QUANTIZATION="ascend"                          # 无量化权重填 none
BLOCK_SIZE=128
EXTRA_VLLM_ARGS=""                             # PD 模式下会同时追加到 P/D 两侧

# ---------------------------------------------------------------- 环境变量微调
HCCL_BUFFSIZE_P=1024
HCCL_BUFFSIZE_D=4096
HCCL_EXEC_TIMEOUT=""                           # 如 "600"；留空用镜像默认
VLLM_ENGINE_READY_TIMEOUT_S=36000              # 大模型加载/图捕获慢时的兜底，别调小
