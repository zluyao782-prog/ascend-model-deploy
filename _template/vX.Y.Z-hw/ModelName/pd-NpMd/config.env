# =============================================================================
# 模板：PD 组网形态配置 —— 复制后按 TODO 逐项替换
#
# 目录：<版本>/<模型>/pd-NpMd/config.env
# 拓扑约定：目录名与 P/D 节点数保持一致，如 pd-2p2d = 2 台 Prefill + 2 台 Decode
# =============================================================================

MODEL_NAME="TODO-模型名"
MODEL_PATH="TODO-权重绝对路径（所有节点必须一致）"
SERVED_MODEL_NAME="TODO-对外模型名"

IMAGE="TODO-镜像tag"
CONTAINER_NAME="TODO-容器名"
WORKDIR_CTR="/opt/ascend-model-deploy"
SHM_SIZE="64g"
EXTRA_MOUNTS=""

NIC_NAME="eth0"
NPU_COUNT="auto"
HOST_MEM_MIN_GB=512                  # PD 的 offload + 多引擎更吃主机内存
DISK_MIN_GB=200
CROSS_NODE=1

DEPLOY_MODE="pd"

# 节点顺序 = DP rank 顺序；第一台是该角色的 DP 协调节点
PREFILL_NODES="TODO-ip1 ip2"
DECODE_NODES="TODO-ip3 ip4"
PROXY_NODE=""                        # 留空取 PREFILL 第一台

# 拓扑：单台引擎数 × TP 应等于单台卡数；全局 DP = 单台引擎数 × 节点数（脚本自动算）
PREFILL_DP_LOCAL=4
DECODE_DP_LOCAL=16
PREFILL_TP=1
DECODE_TP=1
PREFILL_PCP=4                        # 仅 Prefill；Decode 侧固定为 1

PREFILL_BASE_PORT=7100
DECODE_BASE_PORT=7100
DP_RPC_PORT=12321
KV_PRODUCER_PORT=30000               # 按 rank 递增，注意防火墙范围
KV_CONSUMER_PORT=30100
PROXY_PORT=1999
KV_CONNECTOR="MooncakeHybridConnector"

MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS_P=8192
MAX_NUM_BATCHED_TOKENS_D=512
MAX_NUM_SEQS_P=16
MAX_NUM_SEQS_D=72
GPU_MEM_UTIL=0.9
QUANTIZATION="none"
BLOCK_SIZE=128

HCCL_BUFFSIZE_P=1024
HCCL_BUFFSIZE_D=4096
HCCL_EXEC_TIMEOUT=""
VLLM_ENGINE_READY_TIMEOUT_S=36000
