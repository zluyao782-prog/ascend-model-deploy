# =============================================================================
# 模板：单机形态配置 —— 复制后按 TODO 逐项替换
#
# 目录：<版本>/<模型>/single/config.env
# 说明：只写"这一套怎么起"，通用逻辑都在 _shared/
# =============================================================================

MODEL_NAME="TODO-模型名"
MODEL_PATH="TODO-权重绝对路径"
SERVED_MODEL_NAME="TODO-对外模型名"

IMAGE="TODO-镜像tag"                 # 与本文件所在的版本目录一致
CONTAINER_NAME="TODO-容器名"
WORKDIR_CTR="/opt/ascend-model-deploy"
SHM_SIZE="64g"
EXTRA_MOUNTS=""

NIC_NAME="eth0"                      # RoCE 业务口，不是管理口
NPU_COUNT="auto"
HOST_MEM_MIN_GB=256
DISK_MIN_GB=200
CROSS_NODE=0

DEPLOY_MODE="single"

# 单机拓扑：SINGLE_TP × SINGLE_DP 应等于本机卡数
SINGLE_TP=8
SINGLE_DP=1
SINGLE_PORT=8000
SINGLE_EXTRA_ARGS=""                 # 模型私有参数（tokenizer / parser / 量化 / offload 等）

MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS_D=512
MAX_NUM_SEQS_D=32
GPU_MEM_UTIL=0.9
QUANTIZATION="none"                  # 无量化权重填 none
BLOCK_SIZE=128

HCCL_EXEC_TIMEOUT=""
VLLM_ENGINE_READY_TIMEOUT_S=36000
